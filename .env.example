# Copy to .env at the repo root (gitignored). Values must match docker-compose.yml.
#
# MARIADB_ROOT_USERNAME is the MySQL *root* user — not the wordpress app user.
# The pre-commit hook runs mysqldump inside the db container with these creds.

MARIADB_ROOT_USERNAME=root
MARIADB_ROOT_PASSWORD=your_mysql_root_password
MARIADB_DATABASE_NAME=wordpress
MARIADB_CONTAINER_REF=londonparkour_v8-db-1
